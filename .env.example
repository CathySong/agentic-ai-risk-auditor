# Runtime mode
LLM_USE_MOCK=true
DEFAULT_LLM_PROVIDER=openai

# Optional provider keys. Leave blank when using mock mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model defaults
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2000
ANTHROPIC_MODEL=claude-3-haiku-20240307
GOOGLE_MODEL=gemini-pro

# Vector database
CHROMA_DB_PATH=./chroma_db
DEFAULT_COLLECTION=ai_risk_knowledge
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
SEARCH_RESULTS_LIMIT=10
CONTEXT_SIZE_LIMIT=4000

# Tool limits
WEB_SCRAPER_TIMEOUT=60
WEB_SCRAPER_MAX_PAGES=10
WEB_SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; AgenticAIRiskAuditor/1.0)

# API server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
DEBUG=false
LOG_LEVEL=INFO
