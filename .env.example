# LLM configuration
LLM_USE_MOCK=true
LLM_DEFAULT_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_GOOGLE_MODEL=gemini-1.5-flash

# Optional provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Vector database
VECTORDB_CHROMA_DB_PATH=./chroma_db
VECTORDB_DEFAULT_COLLECTION=ai_risk_knowledge
VECTORDB_EMBEDDING_DIMENSION=1536
VECTORDB_SEARCH_RESULTS_LIMIT=10
VECTORDB_CONTEXT_SIZE_LIMIT=4000
VECTORDB_EMBEDDING_BATCH_SIZE=32

# Tool settings
TOOL_WEB_SCRAPER_TIMEOUT=60
TOOL_WEB_SCRAPER_MAX_PAGES=10
TOOL_WEB_SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; AgenticAIRiskAuditor/1.0)

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=true

# General settings
DEBUG=false
LOG_LEVEL=INFO
